---
import Base from "../layouts/Base.astro";
---

<Base title="Not found · g26work" description="This page does not exist on g26work.com." path="/404">
  <header class="board-head">
    <p class="wordmark"><a href="/">g26work</a></p>
  </header>
  <main class="board" aria-labelledby="missing-title">
    <div class="board-bar">
      <h1 id="missing-title">No such page</h1>
      <p class="status"><span>Error 404</span></p>
    </div>
    <p class="missing"><a href="/">Back to the project board</a></p>
  </main>
</Base>
